# Darukaa.Earth Biodiversity AI - Environment Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# LLM Configuration (OpenAI-compatible)
# Leave OPENAI_API_KEY empty to use deterministic calibrated scientific synthesis mode
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Vector DB & Storage
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./data/darukaa_biodiversity.db

# Hallucination Guardrails
STRICT_GROUNDING=true
MIN_CONFIDENCE_THRESHOLD=0.50
MAX_RETRIEVAL_RESULTS=6
