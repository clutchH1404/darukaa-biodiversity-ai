# ==============================================================================
# DARUKAA.EARTH AI BIODIVERSITY INTELLIGENCE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your environment variables.
# NEVER commit real API keys or credentials to version control.

# Application Environment
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# Production CORS & Networking
FRONTEND_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# LLM Provider Configuration (Optional: runs fully offline with calibrated scientific rules)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Persistence & Storage Paths
CHROMA_PERSIST_DIR=data/chroma_db
SQLITE_DB_PATH=data/darukaa_biodiversity.db
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_KNOWLEDGE_DIR=data/knowledge

# Scientific Grounding Thresholds
STRICT_GROUNDING=true
MIN_CONFIDENCE_THRESHOLD=0.50
MAX_RETRIEVAL_RESULTS=6
